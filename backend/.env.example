# Copy file nay thanh ".env" roi dien key that vao, KHONG push file .env len Git

PORT=5000

# Supabase
SUPABASE_URL=
# Backend dung SERVICE ROLE KEY (bo qua RLS) -> bat buoc bat RLS cho bang users.
# Co the dat ten SUPABASE_SERVICE_ROLE_KEY hoac SUPABASE_KEY (uu tien SUPABASE_SERVICE_ROLE_KEY).
SUPABASE_SERVICE_ROLE_KEY=

# JWT
JWT_SECRET=your_secret_key_here
JWT_EXPIRES_IN=1d

# CORS: origin cua frontend, nhieu origin thi cach nhau bang dau phay.
# De trong = cho phep moi origin (chi nen de trong khi dev).
CORS_ORIGIN=http://localhost:3000
