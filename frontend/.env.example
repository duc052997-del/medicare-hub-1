# Copy file nay thanh ".env" roi doi lai URL neu can


# Địa chỉ API (theo hợp đồng API, sheet "Quy ước chung"):
#   Local:   http://localhost:5000/api
#   Staging: <URL Render>/api
VITE_API_URL=https://medicare-hub-qha6.onrender.com/api

# true  = FE chạy bằng dữ liệu giả (src/services/mock), KHÔNG cần backend
# false = FE gọi backend thật ở VITE_API_URL
VITE_USE_MOCK=false